# --- Database -----------------------------------------------------------
# Neon pooled connection string (PgBouncer, transaction mode).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Unpooled (direct) connection — used for migrations / prisma db push.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me"
# Session lifetime in seconds (default 12h)
SESSION_TTL_SECONDS="43200"

# --- BEAIP (Bahamas Customs Single Window) -------------------------------
# mock | production
BEAIP_MODE="mock"
BEAIP_ENDPOINT=""
BEAIP_USERNAME=""
BEAIP_PASSWORD=""
BEAIP_BROKER_CODE=""

# Scratch DB used by the migration engine to compute diffs (created/dropped by
# Prisma). Never point at a database holding real data.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST/submit_shadow"
