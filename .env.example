# --- Database -----------------------------------------------------------
# Neon pooled connection string (PgBouncer, transaction mode).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Unpooled (direct) connection — used for migrations / prisma db push.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me"
# Session lifetime in seconds (default 12h)
SESSION_TTL_SECONDS="43200"

# --- Google sign-in (Google Cloud Console -> APIs & Services -> Credentials) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match an "Authorized redirect URI" on the OAuth client.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Scratch DB used by the migration engine to compute diffs (created/dropped by
# Prisma). Never point at a database holding real data.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST/submit_shadow"

# --- Click2Clear / BEAIP QA --------------------------------------------
# Keep disabled until the broker deliberately enables a controlled QA test.
BEAIP_TRANSPORT_MODE="disabled"
BEAIP_ENVIRONMENT="qa"
BEAIP_DECLARATION_SERVICE_URL=""
BEAIP_DECLARATION_SOAP_ACTION=""
BEAIP_USERNAME=""
BEAIP_PASSWORD=""
BEAIP_BROKER_CODE=""
BEAIP_SENDER=""
BEAIP_RECEIVER="BESWS"
BEAIP_TIMEZONE="America/Nassau"
BEAIP_TIMEOUT_MS="15000"
BEAIP_MAX_RESPONSE_BYTES="1048576"
# The supplied QA service may use HTTP. This exception is refused in production.
BEAIP_ALLOW_INSECURE_QA_HTTP="false"
